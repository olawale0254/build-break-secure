# Sample settings for MaintainerBot. Copy it, then fill in your own keys:
#   cp .env.example .env
#
# .env is gitignored - never commit real keys. This sample stays in the repo.
# Not the same as fake_github/repo/.env, which holds the demo's FAKE keys.
#
# Load .env into your shell before running:
#   set -a; source .env; set +a

# --provider anthropic
ANTHROPIC_API_KEY=

# --provider openai
OPENAI_API_KEY=

# Model names live in models.yaml, not here.
